{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClientConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["clientId", "displayName", "customDomain", "swaResourceName", "features", "theme"],
  "properties": {
    "clientId": { "type": "string" },
    "displayName": { "type": "string" },
    "customDomain": { "type": "string" },
    "swaResourceName": { "type": "string" },
    "template": {
      "type": "string",
      "description": "Name of the template this client is based on (e.g. 'restaurant-standard'). Template pages are used as defaults; client page files override by slug."
    },
    "contactEndpoint": { "type": "string" },
    "externalReviewUrl": { "type": "string" },
    "externalReviewPlatform": { "type": "string" },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blog", "booking", "gallery", "menu"],
      "properties": {
        "blog": { "type": "boolean" },
        "booking": { "type": "boolean" },
        "gallery": { "type": "boolean" },
        "menu": { "type": "boolean" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["bold-restaurant", "modern-minimal", "professional-law", "vibrant-retail", "default"]
        },
        "primaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "textColor": { "type": "string" },
        "surfaceColor": { "type": "string" },
        "surfaceDark": { "type": "string" },
        "fontHeading": { "type": "string" },
        "fontBody": { "type": "string" },
        "borderRadius": { "type": "number" },
        "pageInset": {
          "description": "Horizontal page padding. Accepts a raw CSS value or a responsive object with mobile/tablet/desktop breakpoints.",
          "oneOf": [
            {
              "type": "string",
              "description": "Raw CSS value, e.g. 'clamp(1rem, 5vw, 2rem)' or '1.5rem'."
            },
            {
              "type": "object",
              "required": ["mobile", "desktop"],
              "additionalProperties": false,
              "properties": {
                "mobile":  { "type": "string", "description": "Applied below 768px." },
                "tablet":  { "type": "string", "description": "Applied 768px–1279px (optional)." },
                "desktop": { "type": "string", "description": "Applied at 1280px and above." }
              }
            }
          ]
        },
        "sectionSpacing": {
          "description": "Vertical padding for page sections. Accepts a raw CSS value or a responsive object.",
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["mobile", "desktop"],
              "additionalProperties": false,
              "properties": {
                "mobile":  { "type": "string" },
                "tablet":  { "type": "string" },
                "desktop": { "type": "string" }
              }
            }
          ]
        },
        "contentGap": {
          "description": "Gap between stacked content elements. Accepts a raw CSS value or a responsive object.",
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["mobile", "desktop"],
              "additionalProperties": false,
              "properties": {
                "mobile":  { "type": "string" },
                "tablet":  { "type": "string" },
                "desktop": { "type": "string" }
              }
            }
          ]
        }
      },
      "oneOf": [
        {
          "required": ["preset"]
        },
        {
          "required": ["primaryColor", "accentColor", "backgroundColor", "fontHeading", "fontBody", "borderRadius"]
        }
      ]
    },
    "siteMetadata": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "siteName": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "titleTemplate": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "defaultDescription": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "defaultOgImage": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
          }
        },
        { "type": "null" }
      ]
    },
    "header": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["logo"],
          "properties": {
            "logo": { "type": "string" },
            "ctaLabel": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "ctaAction": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "links": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["label", "href"],
                    "properties": {
                      "label": { "type": "string" },
                      "href": { "type": "string" }
                    }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "footer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "copyright": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
            "columns": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "links"],
                    "properties": {
                      "title": { "type": "string" },
                      "links": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["label", "href"],
                          "properties": {
                            "label": { "type": "string" },
                            "href": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "bottomActionBar": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "href"],
                "properties": {
                  "label": { "type": "string" },
                  "href": { "type": "string" },
                  "icon": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    }
  }
}
