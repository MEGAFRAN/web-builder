{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "services",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "items"],
  "properties": {
    "_type": { "type": "string", "const": "services" },
    "heading": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "price": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "imageUrl": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "imageAlt": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "subItems": {
            "oneOf": [
              {
                "type": "array",
                "items": { "type": "string" }
              },
              { "type": "null" }
            ]
          }
        }
      }
    }
  }
}
