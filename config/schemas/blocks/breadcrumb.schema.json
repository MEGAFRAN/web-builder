{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "breadcrumb",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "items"],
  "properties": {
    "_type": { "type": "string", "const": "breadcrumb" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "href": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
        }
      }
    }
  }
}
