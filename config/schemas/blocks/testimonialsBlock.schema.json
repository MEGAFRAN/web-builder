{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "testimonialsBlock",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "items"],
  "properties": {
    "_type": { "type": "string", "const": "testimonialsBlock" },
    "heading": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "quote"],
        "properties": {
          "name": { "type": "string" },
          "company": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "role": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "quote": { "type": "string" },
          "avatarUrl": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
        }
      }
    }
  }
}
