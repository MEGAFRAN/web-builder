{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "statsBlock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "stats"
  ],
  "properties": {
    "_type": {
      "type": "string",
      "const": "statsBlock"
    },
    "background": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "white",
            "gray",
            "dark"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "label"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "placeholderCopy": {
      "$ref": "./_common.schema.json#/definitions/placeholderCopy"
    }
  }
}
