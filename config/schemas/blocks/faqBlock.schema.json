{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "faqBlock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "items"
  ],
  "properties": {
    "_type": {
      "type": "string",
      "const": "faqBlock"
    },
    "title": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "placeholderCopy": {
      "$ref": "./_common.schema.json#/definitions/placeholderCopy"
    }
  }
}
