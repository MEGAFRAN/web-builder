{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "missionBlock",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "heading", "body"],
  "properties": {
    "_type": { "type": "string", "const": "missionBlock" },
    "heading": { "type": "string" },
    "body": { "type": "string" },
    "imageUrl": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "imageAlt": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
  }
}
