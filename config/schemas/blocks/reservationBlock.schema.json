{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reservationBlock",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type"],
  "properties": {
    "_type": { "type": "string", "const": "reservationBlock" },
    "heading": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "subtext": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "services": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "durationMinutes", "price"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "description": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
              "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
              "price": { "type": "number", "minimum": 0 },
              "currency": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "confirmationMessage": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "clientId": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "availabilityEndpoint": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
  }
}
