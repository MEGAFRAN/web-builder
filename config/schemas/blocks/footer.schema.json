{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "footer",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type"],
  "properties": {
    "_type": { "type": "string", "const": "footer" },
    "columns": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "links"],
            "properties": {
              "title": { "type": "string" },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "href"],
                  "properties": {
                    "label": { "type": "string" },
                    "href": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "copyright": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "placeholderCopy": {
      "$ref": "./_common.schema.json#/definitions/placeholderCopy"
    }
  }
}
