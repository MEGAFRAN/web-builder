{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "heroBlock",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "heading"],
  "properties": {
    "_type": { "type": "string", "const": "heroBlock" },
    "heading": { "type": "string" },
    "subtext": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "primaryButtonLabel": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "primaryButtonHref": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "secondaryButtonLabel": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "secondaryButtonHref": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "backgroundImageUrl": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
  }
}
