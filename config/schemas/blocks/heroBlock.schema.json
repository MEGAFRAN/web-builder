{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "heroBlock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "heading"
  ],
  "properties": {
    "_type": {
      "type": "string",
      "const": "heroBlock"
    },
    "heading": {
      "type": "string"
    },
    "subtext": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "primaryButtonLabel": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "primaryButtonHref": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "backgroundImageUrl": {
      "description": "Hero background image src. Use a same-origin blob path (e.g. /images/hero.webp) in production, or an absolute https URL for templates and dev. Omit or set null for gradient fallback.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(/images/|https://)"
        },
        {
          "type": "null"
        }
      ]
    },
    "placeholderCopy": {
      "$ref": "./_common.schema.json#/definitions/placeholderCopy"
    }
  }
}
