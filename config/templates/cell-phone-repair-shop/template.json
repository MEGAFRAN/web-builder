{
  "templateId": "cell-phone-repair-shop",
  "displayName": "Cell Phone Repair Shop",
  "description": "Repair shop site with services and contact pages.",
  "defaultThemePreset": "repair-shop-es",
  "defaultFeatures": {
    "blog": false,
    "booking": false,
    "gallery": false,
    "menu": false
  },
  "header": {
    "logo": "{{businessName}}",
    "ctaLabel": "WhatsApp",
    "ctaAction": "https://wa.me/{{whatsapp}}",
    "links": [
      { "label": "Servicios", "href": "/servicios" },
      { "label": "Contacto", "href": "/contacto" }
    ]
  },
  "footer": {
    "copyright": "© {{businessName}}. Todos los derechos reservados.",
    "columns": [
      {
        "title": "Navegación",
        "links": [
          { "label": "Servicios", "href": "/servicios" },
          { "label": "Contacto", "href": "/contacto" }
        ]
      },
      {
        "title": "Contacto",
        "links": [
          { "label": "{{phone}}", "href": "tel:{{phone}}" },
          { "label": "{{address}}", "href": "#" }
        ]
      }
    ]
  },
  "bottomActionBar": {
    "items": [
      {
        "label": "Llamar",
        "href": "tel:{{phone}}",
        "icon": "public/call.svg",
        "iconColor": "#ffffff"
      },
      {
        "label": "WhatsApp",
        "href": "https://wa.me/{{whatsapp}}",
        "icon": "public/whatsapp.svg",
        "iconColor": "#25D366"
      }
    ]
  }
}
