{
  "name": "web-builder-reservation-api",
  "version": "1.0.0",
  "description": "Azure Function App — reservation backend for web-builder clients",
  "main": "dist/src/functions/**/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "func start",
    "dev": "npm run build && func start",
    "test": "npm run build && node --test dist/src/__tests__/*.test.js",
    "deploy": "npm run build && func azure functionapp publish web-builder-api"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.1",
    "@azure/functions": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.4.5"
  }
}
