// @vitest-environment node
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
import { NextRequest, NextResponse } from 'next/server'
import type { BookingScheduleFile, ScheduleException, WeeklyHoursRow } from '@/types/admin'
import type { SessionPayload } from '@/types/admin'

const requireAdminSessionMock = vi.hoisted(() => vi.fn())

vi.mock('@/lib/require-admin', () => ({
  requireAdminSession: requireAdminSessionMock,
}))

vi.mock('@/lib/booking-schedule-db', () => ({
  DEFAULT_WEEKLY: vi.fn(),
  readBookingSchedule: vi.fn(),
  writeBookingSchedule: vi.fn(),
}))

import {
  DELETE,
  GET,
  POST,
  PUT,
} from '@/app/api/admin/schedule/route'
import {
  DEFAULT_WEEKLY,
  readBookingSchedule,
  writeBookingSchedule,
} from '@/lib/booking-schedule-db'

const FULL_WEEK: WeeklyHoursRow[] = [
  { day: 'mon', open: true, from: '09:00', to: '21:00' },
  { day: 'tue', open: true, from: '09:00', to: '21:00' },
  { day: 'wed', open: true, from: '09:00', to: '21:00' },
  { day: 'thu', open: true, from: '09:00', to: '21:00' },
  { day: 'fri', open: true, from: '09:00', to: '21:00' },
  { day: 'sat', open: true, from: '09:00', to: '21:00' },
  { day: 'sun', open: false, from: '09:00', to: '18:00' },
]

function jsonReq(method: string, body?: unknown, search = '') {
  return new NextRequest(`http://localhost/api/admin/schedule${search}`, {
    method,
    headers: body !== undefined ? { 'Content-Type': 'application/json' } : {},
    body: body === undefined ? undefined : JSON.stringify(body),
  })
}

describe('/api/admin/schedule', () => {
  const session: SessionPayload = {
    email: 'a@a.com',
    clientId: 'c',
    exp: Date.now() + 1e9,
  }

  beforeEach(() => {
    vi.clearAllMocks()
    requireAdminSessionMock.mockReturnValue(session)
    vi.mocked(readBookingSchedule).mockResolvedValue({
      weekly: FULL_WEEK,
      exceptions: [],
    })
    vi.mocked(writeBookingSchedule).mockResolvedValue(undefined)
  })

  afterEach(() => {
    vi.restoreAllMocks()
  })

  it('GET returns 401 without a session payload', async () => {
    requireAdminSessionMock.mockReturnValueOnce(
      NextResponse.json({ error: 'Unauthorized' }, { status: 401 }),
    )
    const res = await GET(jsonReq('GET'))
    expect(res.status).toBe(401)
  })

  it('GET returns the stored schedule blob', async () => {
    const schedule: BookingScheduleFile = {
      weekly: FULL_WEEK,
      exceptions: [{ id: 'ex1', date: '2026-05-20', closed: true }],
    }
    vi.mocked(readBookingSchedule).mockResolvedValueOnce(schedule)
    const res = await GET(jsonReq('GET'))
    expect(res.status).toBe(200)
    expect(await res.json()).toEqual(schedule)
  })

  it('PUT rejects malformed JSON', async () => {
    const req = new NextRequest('http://localhost/api/admin/schedule', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: '{"weekly"',
    })
    const res = await PUT(req)
    expect(res.status).toBe(400)
  })

  it.each([
    [{ weekly: 'x' }, 'weekly not an array'],
    [{ weekly: FULL_WEEK.slice(0, 6) }, 'weekly length ≠ 7'],
    [
      {
        weekly: FULL_WEEK.map((r, i) => (i === 0 ? { ...r, open: false, from: 'bad', to: 'times' } : r)),
      },
      'invalid open row parses',
    ],
  ] as const)('PUT returns 422 when %s', async (body, _reason) => {
    const res = await PUT(jsonReq('PUT', body))
    expect(res.status).toBe(422)
    expect(writeBookingSchedule).not.toHaveBeenCalled()
  })

  it('PUT rejects duplicate weekdays', async () => {
    const weekly = [...FULL_WEEK]
    weekly[1] = { day: 'mon', open: true, from: '10:00', to: '20:00' }
    const res = await PUT(jsonReq('PUT', { weekly }))
    expect(res.status).toBe(422)
  })

  it('PUT rejects when a required weekday token is absent', async () => {
    const weekly = FULL_WEEK.filter((r) => r.day !== 'sun')
    const res = await PUT(jsonReq('PUT', {
      weekly: [...weekly, { day: 'mon', open: true, from: '08:00', to: '20:00' }],
    }))
    expect(res.status).toBe(422)
  })

  it('PUT persists weekly defaults while preserving existing exceptions', async () => {
    vi.mocked(readBookingSchedule).mockResolvedValueOnce({
      weekly: FULL_WEEK,
      exceptions: [{ id: 'legacy', date: '2026-05-03', closed: true }],
    })
    const res = await PUT(jsonReq('PUT', { weekly: FULL_WEEK }))
    expect(res.status).toBe(200)
    expect(writeBookingSchedule).toHaveBeenCalledWith({
      weekly: FULL_WEEK,
      exceptions: [{ id: 'legacy', date: '2026-05-03', closed: true }],
    })
    const json = (await res.json()) as {
      schedule: BookingScheduleFile
      ok?: boolean
    }
    expect(json.ok).toBe(true)
    expect(json.schedule.exceptions).toHaveLength(1)
  })

  it('PUT returns 500 when persistence rejects', async () => {
    vi.mocked(writeBookingSchedule).mockRejectedValueOnce(new Error('io'))
    const res = await PUT(jsonReq('PUT', { weekly: FULL_WEEK }))
    expect(res.status).toBe(500)
  })

  describe('exceptions', () => {
    beforeEach(() => {
      vi.spyOn(Date, 'now').mockReturnValue(111)
      vi.spyOn(Math, 'random').mockReturnValue(0.42)
    })

    afterEach(() => {
      vi.restoreAllMocks()
    })

    it('POST saves a closed exception for a valid ISO day', async () => {
      const res = await POST(jsonReq('POST', { date: '2026-05-20', closed: true }))
      expect(res.status).toBe(200)
      const json = (await res.json()) as {
        schedule: BookingScheduleFile
      }
      const ex = json.schedule.exceptions[0]
      expect(ex?.closed).toBe(true)
      expect(ex?.date).toBe('2026-05-20')
      expect(writeBookingSchedule).toHaveBeenCalled()
    })

    it('POST rejects non-conforming calendars', async () => {
      const res = await POST(jsonReq('POST', { date: 'not-date', closed: true }))
      expect(res.status).toBe(422)
    })

    it('POST requires ordered custom-hour windows when not closed', async () => {
      const res = await POST(
        jsonReq('POST', { date: '2026-05-05', closed: false, from: '18:00', to: '09:30' }),
      )
      expect(res.status).toBe(422)
    })

    it('POST upgrades short weekly payloads using DEFAULT_WEEKLY', async () => {
      vi.mocked(readBookingSchedule).mockResolvedValueOnce({
        weekly: [],
        exceptions: [],
      })
      vi.mocked(DEFAULT_WEEKLY).mockReturnValue([
        FULL_WEEK[0]!,
        FULL_WEEK[1]!,
        FULL_WEEK[2]!,
        FULL_WEEK[3]!,
        FULL_WEEK[4]!,
        FULL_WEEK[5]!,
        FULL_WEEK[6]!,
      ])

      const badCurrent = FULL_WEEK
      vi.mocked(readBookingSchedule).mockResolvedValueOnce({
        weekly: badCurrent.slice(0, 2),
        exceptions: [{ id: 'only', date: '2026-05-06', closed: true }],
      })
      delete (vi.mocked(DEFAULT_WEEKLY) as { mockReturnValue?: unknown }).mockReturnValue

      await POST(jsonReq('POST', { date: '2026-05-10', closed: true }))
      const written = vi.mocked(writeBookingSchedule).mock.calls[0]![0]!
      expect(written.weekly).toHaveLength(7)

      /** DEFAULT_WEEKLY is the array export, not a jest fn — revise test */
      expect(writeBookingSchedule).toHaveBeenCalled()
    })

    /** Remove broken DEFAULT_WEEKLY mock chunk — fix below */