# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# storybook
/storybook-static

# next.js
/.next/
/out/
/public/images/

# blob-build temp dir (created by scripts/prepare-static-export.mjs, always restored)
/.blob-excluded/

# admin-build temp dir (created by scripts/prepare-admin-export.mjs, always restored)
/.admin-excluded/

# production
/build

# misc
.DS_Store
*.pem
.claude/tasks

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
